include LICENSE README.md pyproject.toml THIRD_PARTY_NOTICES.md
recursive-include licenses *.txt
graft src
prune .github
prune docs
prune examples
prune scripts
prune tests
prune .superpowers
prune src/tennetsac.egg-info
exclude src/tennetsac.egg-info/*
exclude CITATION.bib CITATION.ris
exclude TeNNet-SAC.yml requirements.txt TrainingSystemsList.csv architecture.png
exclude .gitignore TeNNetSAC.ipynb
global-exclude *.py[cod] *.so
global-exclude *.pt *.safetensors
include src/tennetsac/ckpt_files/fine-tuned/gamma-ensemble-v1.safetensors
prune src/**/__pycache__
